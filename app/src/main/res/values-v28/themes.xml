<resources>
    <!--
        Edge-to-edge theme for CampusFind+
        Transparent system bars for gradient backgrounds
    -->
    <style name="Theme.CampusFind" parent="android:Theme.Material.Light.NoActionBar">
        <!-- ✅ Transparent status and navigation bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- ✅ Light status bar icons by default -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>